# ProofPnL — environment variables
# Copy this file to .env and fill in your values.
# On Vercel: add these in Project Settings → Environment Variables.

# ── Required ────────────────────────────────────────────────────
# Your Primus Developer Hub App ID (bundled into the browser via Vite)
VITE_APP_ID=

# Your Primus App Secret — backend/serverless only.
# NEVER prefix with VITE_; that would expose it to the browser.
APP_SECRET=

# ── Optional ────────────────────────────────────────────────────
# Primus Binance Spot PnL template ID.
# A default is already hardcoded in src/hooks/usePrimusAttestation.js.
# VITE_TEMPLATE_ID=

# Local Express backend port (used by npm start; ignored on Vercel).
# PORT=3001
